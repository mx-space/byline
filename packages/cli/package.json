{
  "name": "@mx-space/byline-cli",
  "version": "0.7.0",
  "description": "Command line tools for the Byline headless CMS, including a generic MDX importer",
  "keywords": [
    "byline",
    "headless-cms",
    "mdx",
    "lexical",
    "cli"
  ],
  "homepage": "https://github.com/mx-space/byline/tree/main/packages/cli#readme",
  "bugs": "https://github.com/mx-space/byline/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mx-space/byline.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Innei",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "bin",
    "dist",
    "examples",
    "README.md"
  ],
  "bin": {
    "byline": "bin/byline.mjs"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/bin/byline.ts",
    "lint": "eslint src __tests__ --fix",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@haklex/rich-headless": "0.61.0",
    "@lexical/headless": "^0.53.0",
    "@lexical/list": "^0.53.0",
    "@mx-space/cli": "0.21.6",
    "@mx-space/editor": "0.5.1",
    "lexical": "^0.53.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@mx-space/byline-api-client": "workspace:*",
    "@types/estree": "^1.0.10",
    "@types/mdast": "^4.0.4",
    "@types/node": "26.6.6",
    "mdast-util-mdx-jsx": "^3.2.0",
    "tsdown": "0.23.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
