{
  "unknown": "placeholder",
  "placeholderUrl": "urn:byline:unmapped-component:{name}",
  "components": {
    "Image": {
      "node": "image",
      "props": {
        "src": "src",
        "altText": { "from": "alt", "default": "" },
        "width": { "from": "width", "type": "number" },
        "height": { "from": "height", "type": "number" }
      }
    },
    "Video": {
      "node": "video",
      "props": {
        "src": "src",
        "poster": "poster",
        "width": { "from": "width", "type": "number" },
        "height": { "from": "height", "type": "number" }
      }
    },
    "Callout": {
      "node": "banner",
      "props": {
        "bannerType": {
          "from": "type",
          "map": {
            "info": "note",
            "note": "note",
            "tip": "tip",
            "important": "important",
            "warning": "warning",
            "error": "caution",
            "danger": "caution"
          },
          "default": "note"
        }
      },
      "children": { "state": "content" }
    },
    "Card": {
      "markdown": "![{title}]({image})\n\n[{title}]({href})"
    },
    "Cards": {
      "node": "grid-container",
      "props": {
        "cols": { "value": 3 },
        "gap": { "value": "16px" }
      },
      "children": { "cells": "cells" }
    },
    "Steps": {
      "node": "steps",
      "children": {
        "sections": "steps",
        "heading": 3,
        "title": {
          "replace": [
            {
              "pattern": "^(?:(?:Step|Stap|Paso|Schritt|Bước|Стъпка|Шаг|Étape|Adım|Passo|ステップ|Passaggio|Krok|Etapa|Método|Metodo|Metoda|Méthode|Methode|Method|Метод|Способ|Yöntem|Cách|방법|단계|الخطوة|الطريقة)\\s*(?:\\d+|[一二三四五六七八九十]+|\\p{L}+)|\\d+\\s*(?:단계|\\.\\s*Adım)|第\\s*[一二三四五六七八九十\\d]+\\s*[步种種]|(?:步[骤驟]|方法|方式)\\s*[一二三四五六七八九十\\d]+)\\s*[:：.．]\\s*",
              "with": ""
            }
          ],
          "reportUnmatched": true
        }
      }
    },
    "X": {
      "node": "embed",
      "props": {
        "url": { "template": "https://x.com/i/status/{id}" },
        "source": { "value": "tweet" }
      }
    },
    "LobeEvalLeaderboard": {
      "dynamic": {
        "url": "https://cdn.example.com/lobehub/byline/lobe-eval-leaderboard.mjs",
        "initialHeight": 640,
        "props": { "locale": "locale" }
      }
    }
  }
}
