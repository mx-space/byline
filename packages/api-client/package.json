{
  "name": "@mx-space/byline-api-client",
  "version": "0.1.2",
  "description": "Typed fetch client for the Byline headless CMS API",
  "keywords": [
    "byline",
    "headless-cms",
    "api-client",
    "lexical"
  ],
  "homepage": "https://github.com/mx-space/byline/tree/main/packages/api-client#readme",
  "bugs": "https://github.com/mx-space/byline/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mx-space/byline.git",
    "directory": "packages/api-client"
  },
  "license": "MIT",
  "author": "Innei",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src __tests__ --fix",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsdown": "0.23.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
