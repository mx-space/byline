# Copy to .env and fill for local dev. In CI these come from repo secrets/vars.

# Base URL of the Byline API the admin talks to (e.g. http://localhost:2333).
# Empty falls back to same-origin; in this monorepo the sibling app apps/server serves it.
VITE_APP_BASE_API=

# Public-facing URL of the consumer site, used for "view on site" links.
VITE_APP_WEB_URL=

# Optional real-time gateway base URL. Empty derives from the API origin.
VITE_APP_GATEWAY=

# Production asset base path (Vite `base`). Must match how the server serves the
# admin. Empty ("") = relative paths, which is the safe default.
# Only set this if assets are hosted under a non-root path. Ignored in dev.
VITE_APP_PUBLIC_URL=
