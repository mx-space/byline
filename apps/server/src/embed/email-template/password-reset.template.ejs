<!doctype html>
<html>
  <body style="margin:0;padding:24px;background:#f6f6f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#18181b;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
      <tr>
        <td align="center">
          <table role="presentation" width="480" cellspacing="0" cellpadding="0" style="background:#ffffff;border-radius:12px;padding:32px;">
            <tr>
              <td>
                <h1 style="margin:0 0 16px;font-size:20px;">Reset your <%= siteName %> password</h1>
                <p style="margin:0 0 16px;line-height:1.6;">
                  Hi <%= displayName %>, we received a request to reset the password for your account.
                </p>
                <p style="margin:0 0 24px;">
                  <a href="<%= resetUrl %>" style="display:inline-block;padding:10px 18px;background:#18181b;color:#ffffff;border-radius:8px;text-decoration:none;">Reset password</a>
                </p>
                <p style="margin:0;font-size:13px;color:#71717a;line-height:1.6;">
                  If you did not request this, you can ignore this email. If the button does not work, open <%= resetUrl %>
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
